Project Neoraptor {
  database_type: "PostgreSQL"
  Note: "Proposed M1 schema only. No migration or database implementation exists. See docs/m1-protocol.md for transaction, privilege, recovery, and constraint requirements that DBML notes do not enforce."
}

Enum actor_kind {
  operator
  control_service
  broker
  worker_report
}

Enum idempotency_outcome {
  accepted
  busy
  rejected
}

Enum idempotency_rejection_code {
  capture_budget_exhausted
}

Enum execution_slot_state {
  enabled
  recovery_disabled
}

Enum launch_progress {
  reserved
  claimed
  launch_authorized
  create_requested
  container_created
  start_requested
  worker_started
  launch_failed
}

Enum worker_presence {
  not_created
  creation_unknown
  created
  start_unknown
  running
  stopped
  absent
  ownership_unknown
}

Enum cancellation_status {
  not_requested
  requested
}

Enum execution_outcome_knowledge {
  not_established
  not_started
  completed
  interrupted
  unknown
}

Enum attempt_outcome_reason {
  denied
  cancelled
  launch_failed
}

Enum artifact_lifecycle {
  staging
  finalized
}

Enum capture_completeness {
  complete
  incomplete
}

Enum observation_availability {
  unavailable
  complete
  incomplete
}

Enum capture_reason_code {
  source_unavailable
  source_error
  cap_exceeded
  worker_terminated
  persistence_failure
  recovery_interrupted
  integrity_failure
}

Enum event_kind {
  run_created
  request_proposed
  policy_evaluated
  start_busy
  approval_recorded
  policy_revoked
  attempt_prepared
  dispatch_intent
  execution_claimed
  launch_authorized
  launch_denied
  worker_created
  worker_started
  observation_recorded
  capture_incomplete
  cancellation_requested
  worker_stopped
  launch_failed
  attempt_outcome_recorded
  attempt_interrupted
  reconciliation_recorded
  artifact_finalized
}

Table operators {
  id              uuid [pk]
  identity_name   text [not null, unique]
  active          boolean [not null, default: true]
  created_at      timestamptz [not null]

  Note: "Contains identity references only. Never store bearer credential material here."
}

Table fixture_config_revisions {
  id                uuid [pk]
  revision          integer [not null, unique]
  fixture_key       text [not null]
  endpoint_ipv4     text [not null]
  endpoint_port     integer [not null]
  fixed_path        text [not null, default: '/']
  config_digest     text [not null, unique]
  created_by        uuid [not null, ref: > operators.id]
  created_at        timestamptz [not null]

  Note: "Immutable deployment configuration. fixture_key uses the M1 ASCII rule [A-Za-z0-9][A-Za-z0-9._-]{0,127}, case-sensitive, without trimming or normalization; request keys use the same validation and must match exactly. Database/application constraints must reject changes after creation. IPv4 syntax, port range, endpoint allowlist, and fixed path are validated before readiness."
}

Table execution_config_revisions {
  id                    uuid [pk]
  revision              integer [not null, unique]
  worker_image_digest   text [not null]
  fixture_image_digest  text [not null]
  firewall_profile      text [not null]
  resource_limits       jsonb [not null]
  config_digest         text [not null, unique]
  created_by            uuid [not null, ref: > operators.id]
  created_at            timestamptz [not null]

  Note: "Immutable deployment configuration including pinned image digests, network/firewall profile identity, and bounded execution settings. A changed revision requires policy reevaluation."
}

Table runs {
  id             uuid [pk]
  created_by     uuid [not null, ref: > operators.id]
  created_at     timestamptz [not null]

  Indexes {
    (id, created_by) [unique, name: "uniq_run_identity_owner"]
  }

  Note: "Run identity is created before approval so legitimate pre-approval events do not need a fabricated authorization reference. Current run state belongs in events/projections, not a mutable authoritative status column."
}

Table scope_policies {
  id                            uuid [pk]
  run_id                        uuid [not null, ref: > runs.id]
  revision                      integer [not null]
  fixture_config_revision_id    uuid [not null, ref: > fixture_config_revisions.id]
  execution_config_revision_id  uuid [not null, ref: > execution_config_revisions.id]
  policy_document               jsonb [not null]
  valid_from                    timestamptz [not null]
  valid_until                   timestamptz [not null]
  created_by                    uuid [not null, ref: > operators.id]
  created_at                    timestamptz [not null]

  Indexes {
    (run_id, id) [unique, name: "uniq_policy_run_id"]
    (run_id, revision) [unique, name: "uniq_policy_run_revision"]
    (run_id, id, fixture_config_revision_id, execution_config_revision_id) [unique, name: "uniq_policy_approved_configuration"]
  }

  Note: "Immutable policy revision. Enforce valid_from < valid_until and prevent update/delete through database constraints/roles in the eventual migration."
}

Table probe_requests {
  id                uuid [pk]
  run_id            uuid [not null, ref: > runs.id]
  schema_version    integer [not null]
  fixture_key       text [not null]
  method            text [not null, default: 'GET']
  fixed_path        text [not null, default: '/']
  normalized_request_data jsonb [not null]
  created_by        uuid [not null, ref: > operators.id]
  created_at        timestamptz [not null]

  Indexes {
    (run_id, id) [unique, name: "uniq_request_run_id"]
  }

  Note: "Execution-relevant normalized request data is immutable and consists exactly of schema_version, fixture_key, method, and fixed_path. Compare the complete normalized value exactly; M1 has no request digest. fixture_key uses the M1 ASCII rule [A-Za-z0-9][A-Za-z0-9._-]{0,127}, case-sensitive, without trimming or normalization. This is not an HTTP request body. Validation permits only the fixed M1 request shape; no caller headers, cookies, credentials, query, body, proxy, URL, or path override."
}

Table approvals {
  id                  uuid [pk]
  run_id              uuid [not null, ref: > runs.id]
  request_id          uuid [not null]
  policy_revision_id  uuid [not null]
  fixture_config_revision_id    uuid [not null]
  execution_config_revision_id  uuid [not null]
  operator_id         uuid [not null, ref: > operators.id]
  approved_at         timestamptz [not null]
  resource_limits     jsonb [not null]

  Indexes {
    (run_id, id) [unique, name: "uniq_approval_run_id"]
    (run_id, request_id, id) [unique, name: "uniq_approval_exact_request"]
  }

  Note: "The operator's explicit approval binds the exact request to the policy and both immutable configuration revisions, and to approved resource limits that must satisfy policy/configuration ceilings. It records asserted authorization, not proof of legal ownership; enforce the limit relationship transactionally."
}

Table policy_revocations {
  id                  uuid [pk]
  run_id              uuid [not null, ref: > runs.id]
  policy_revision_id  uuid [not null]
  operator_id         uuid [not null, ref: > operators.id]
  reason_code         text [not null]
  revoked_at          timestamptz [not null]

  Indexes {
    (run_id, policy_revision_id) [unique, name: "uniq_policy_revocation"]
  }

  Note: "Append-only revocation fact. Revocation is serialized against launch authorization using the transaction protocol in docs/m1-protocol.md."
}

Table execution_attempts {
  id               uuid [pk]
  run_id           uuid [not null, ref: > runs.id]
  request_id       uuid [not null]
  approval_id      uuid [not null]
  attempt_number   integer [not null]
  created_by       uuid [not null, ref: > operators.id]
  created_at       timestamptz [not null]

  Indexes {
    (run_id, id) [unique, name: "uniq_attempt_run_id"]
    (run_id, request_id, approval_id, id) [unique, name: "uniq_attempt_approval_binding"]
    (run_id, attempt_number) [unique, name: "uniq_attempt_run_number"]
  }

  Note: "The composite approval reference must authorize this exact request identity; normalized-value equality or sharing its run is not sufficient. Authoritative lifecycle/outcome facts remain events. A manual retry is a separately approved request and a new attempt."
}

Table start_idempotency {
  id                       uuid [pk]
  operator_id              uuid [not null, ref: > operators.id]
  operation                text [not null, default: 'start']
  idempotency_key          text [not null]
  normalized_request_data  jsonb [not null]
  outcome                  idempotency_outcome [not null]
  rejection_code           idempotency_rejection_code
  run_id                   uuid [not null, ref: > runs.id]
  request_id               uuid [not null]
  approval_id              uuid
  attempt_id               uuid
  created_at               timestamptz [not null]

  Indexes {
    (operator_id, operation, idempotency_key) [unique, name: "uniq_idempotency_scope_key"]
  }

  Note: "Authenticate before lookup. Retain the scoped key, complete normalized request value, and final result without silent expiry or reuse; no request digest is used. normalized_request_data must equal the referenced immutable request data. Accepted requires null rejection_code and non-null approval_id/attempt_id; busy requires null rejection_code/approval_id/attempt_id; rejected requires non-null rejection_code and null approval_id/attempt_id. Enforce these conditions and relationships with database constraints/transactions; DBML does not enforce them."
}

Table broker_instances {
  id              uuid [pk]
  deployment_id   uuid [not null]
  host_identity   text [not null]
  started_at      timestamptz [not null]

  Indexes {
    (deployment_id, id) [unique, name: "uniq_broker_deployment_instance"]
  }

  Note: "Durable identity reference only. Exclusive live broker ownership comes from a protected OS service lock; database replay does not restore that lock or permit lease-timeout failover."
}

Table execution_claims {
  attempt_id              uuid [pk, ref: > execution_attempts.id]
  launch_progress         launch_progress [not null]
  worker_presence         worker_presence [not null]
  cancellation_status     cancellation_status [not null]
  outcome_knowledge       execution_outcome_knowledge [not null]
  outcome_reason          attempt_outcome_reason
  broker_instance_id      uuid [ref: > broker_instances.id]
  worker_identity         uuid [not null, unique]
  container_id            text [unique]
  create_start_started_at timestamptz
  start_requested_at      timestamptz
  observed_worker_started_at timestamptz
  reserved_at             timestamptz [not null]
  claimed_at              timestamptz
  updated_at              timestamptz [not null]

  Note: "Mutable live coordination state, not replay-derived authority. The broker owner is null while reserved and assigned once at claim. Keep launch progress, cancellation, worker presence, and outcome mirror separate; worker stop may coexist with unknown outcome. outcome_knowledge and outcome_reason are a non-authoritative mirror of accepted attempt_outcome_recorded events: not_established has no reason; not_started requires exactly one of denied, cancelled, launch_failed; completed, interrupted, and unknown have no reason. Never infer outcome from observation availability/completeness. Only the owning broker incarnation advances a live claim. Persist worker identity before creation. Exact container ownership requires verified stored identity/labels and container ID; a name prefix alone is insufficient. Wall-clock timestamps are reporting data, not enforcement timers."
}

Table deployment_execution_slot {
  slot_id             integer [pk]
  state               execution_slot_state [not null]
  active_attempt_id   uuid [unique, ref: > execution_attempts.id]
  updated_at          timestamptz [not null]

  Note: "Exactly one row with slot_id=1 is required. Enforce singleton, atomic row locking, enabled/recovery-disabled rules, and release only after confirmed worker stop and required cleanup in the migration/transaction implementation."
}

Table run_events {
  id                    uuid [pk]
  run_id                uuid [not null, ref: > runs.id]
  event_sequence        bigint [not null]
  schema_version        integer [not null]
  kind                  event_kind [not null]
  actor                  actor_kind [not null]
  actor_operator_id     uuid [ref: > operators.id]
  actor_reference       text [not null]
  request_id            uuid
  policy_revision_id    uuid
  attempt_id            uuid
  payload               jsonb [not null]
  recorded_at           timestamptz [not null]

  Indexes {
    (run_id, event_sequence) [unique, name: "uniq_run_event_sequence"]
    (run_id, id) [unique, name: "uniq_run_event_id"]
    (run_id, recorded_at) [name: "idx_run_event_time"]
  }

  Note: "Explicit schema version from first persisted event. Payload excludes artifact bytes. Events are immutable accepted facts; database roles/constraints must deny update/delete. Pre-approval events may have null policy/request/attempt references. An attempt_outcome_recorded event must reference an existing attempt in the same run and carry outcome_knowledge (not_started, completed, interrupted, or unknown); not_started requires exactly one outcome_reason (denied, cancelled, launch_failed), and other outcomes require no reason. not_established is an initial claim mirror state, not an outcome event. This event is the sole event kind that records an attempt outcome; launch_failed and attempt_interrupted remain supporting facts. Accepted outcome events are authoritative; execution_claims mirrors them non-authoritatively. Outcome does not derive from attempt_observations availability or artifact completeness. Replay/projection rebuild applies recorded facts only and cannot create/change outcomes, authorize execution, or launch a worker. Enforce actor-kind identity requirements and append next sequence under expected-revision transaction locking."
}

Table run_projections {
  run_id                 uuid [pk, ref: > runs.id]
  last_event_sequence    bigint [not null]
  projection_schema      integer [not null]
  projection_data        jsonb [not null]
  updated_at             timestamptz [not null]

  Note: "Rebuildable inspection projection. It is not authoritative and must not drive authorization, slot ownership, or live dispatch."
}

Table run_capture_accounting {
  run_id             uuid [pk, ref: > runs.id]
  capture_limit      bigint [not null]
  reserved_bytes    bigint [not null]
  retained_bytes    bigint [not null]
  updated_at         timestamptz [not null]

  Note: "Serialize reservations and retained-byte updates transactionally. Staging bytes remain covered by reserved_bytes. On finalization transfer exact retained bytes from reservation to retained_bytes and release unused reservation; on abandoned staging cleanup release reservation. Enforce nonnegative values and reserved_bytes + retained_bytes within the configured aggregate cap in database constraints/transactions."
}

Table evidence_artifacts {
  id                       uuid [pk]
  run_id                   uuid [not null, ref: > runs.id]
  attempt_id               uuid [not null]
  lifecycle                artifact_lifecycle [not null]
  capture_completeness     capture_completeness
  capture_reason_code      capture_reason_code
  max_retained_bytes       bigint [not null]
  reserved_bytes           bigint [not null]
  retained_bytes           bigint [not null]
  content_type             text [not null]
  response_metadata        jsonb [not null]
  retained_digest          text
  created_at               timestamptz [not null]
  finalized_at             timestamptz

  Indexes {
    (run_id, id) [unique, name: "uniq_artifact_run_id"]
    (run_id, attempt_id, id) [unique, name: "uniq_artifact_attempt_identity"]
    (run_id, attempt_id) [name: "idx_artifact_attempt"]
  }

  Note: "Application-level HTTP data only, not wire bytes. Lifecycle (staging/finalized) is separate from capture completeness (complete/incomplete); a finalized artifact may be incomplete. Staging has no finalized completeness value; finalized has exactly one, finalized_at is set, and reserved_bytes is zero. Response metadata is limited to bounded status, content type, and content-length. Finalized artifacts require exact retained byte count and digest, including the digest of empty bytes for a zero-byte complete response. Incomplete capture requires a bounded reason code; complete capture has none. Enforce valid combinations, reservation accounting, finalization, and immutability with database constraints/transactions; DBML notes do not enforce them."
}

Table attempt_observations {
  id              uuid [pk]
  run_id          uuid [not null]
  attempt_id      uuid [not null]
  availability    observation_availability [not null]
  reason_code     capture_reason_code
  artifact_id     uuid
  event_id        uuid [not null]
  recorded_at     timestamptz [not null]

  Indexes {
    (run_id, id) [unique, name: "uniq_observation_run_id"]
    (run_id, attempt_id) [unique, name: "uniq_attempt_observation"]
  }

  Note: "Execution outcome remains an attempt fact and is not inferred from this observation. event_id references the accepted observation_recorded event. Unavailable requires a reason and no artifact; complete requires a finalized complete artifact and no reason; incomplete requires a reason and may reference a finalized incomplete artifact or no artifact when nothing was retained. A zero-byte complete response has a finalized artifact with zero retained bytes and the digest of empty bytes; it is not unavailable. Enforce cross-row state agreement and event-kind/linkage rules transactionally."
}

Table artifact_chunks {
  run_id          uuid [not null]
  artifact_id     uuid [not null]
  chunk_number    integer [not null]
  chunk_bytes     bytea [not null]
  byte_count      integer [not null]
  created_at      timestamptz [not null]

  Indexes {
    (run_id, artifact_id, chunk_number) [pk, name: "pk_artifact_chunk_position"]
  }

  Note: "Bound chunk size at the production read/write boundary and verify byte_count equals octet_length(chunk_bytes). Finalized artifacts reject chunk insert/update/delete; cleanup of staging/orphan rows is bounded and audited."
}

Table artifact_event_links {
  run_id        uuid [not null]
  artifact_id   uuid [not null]
  event_id      uuid [not null]
  link_kind     text [not null]
  created_at    timestamptz [not null]

  Indexes {
    (artifact_id) [pk, name: "pk_artifact_event_link"]
    (run_id, event_id) [name: "idx_artifact_event_link_event"]
  }

  Note: "For an artifact, link event_id to its accepted artifact_finalized event in the same transaction that writes the observation_recorded event/row and finalized metadata. An unfinished artifact has no finalized-evidence link."
}

Ref: approvals.(run_id, request_id) > probe_requests.(run_id, id)
Ref: approvals.(run_id, policy_revision_id, fixture_config_revision_id, execution_config_revision_id) > scope_policies.(run_id, id, fixture_config_revision_id, execution_config_revision_id)
Ref: policy_revocations.(run_id, policy_revision_id) > scope_policies.(run_id, id)
Ref: execution_attempts.(run_id, request_id, approval_id) > approvals.(run_id, request_id, id)
Ref: start_idempotency.(run_id, request_id) > probe_requests.(run_id, id)
Ref: start_idempotency.(run_id, request_id, approval_id, attempt_id) > execution_attempts.(run_id, request_id, approval_id, id)
Ref: run_events.(run_id, request_id) > probe_requests.(run_id, id)
Ref: run_events.(run_id, policy_revision_id) > scope_policies.(run_id, id)
Ref: run_events.(run_id, attempt_id) > execution_attempts.(run_id, id)
Ref: evidence_artifacts.(run_id, attempt_id) > execution_attempts.(run_id, id)
Ref: attempt_observations.(run_id, attempt_id) > execution_attempts.(run_id, id)
Ref: attempt_observations.(run_id, attempt_id, artifact_id) > evidence_artifacts.(run_id, attempt_id, id)
Ref: attempt_observations.(run_id, event_id) > run_events.(run_id, id)
Ref: artifact_chunks.(run_id, artifact_id) > evidence_artifacts.(run_id, id)
Ref: artifact_event_links.(run_id, artifact_id) > evidence_artifacts.(run_id, id)
Ref: artifact_event_links.(run_id, event_id) > run_events.(run_id, id)

// Historical context: the prior proposal included findings, escalations,
// coverage maps, snapshots, and object-storage options. Those structures are
// not part of the active M1 model. Findings, escalations, coverage, recovery
// snapshots, and object storage are deferred pending separate design review
// and demonstrated need.
//
// DBML is descriptive. Its notes do not enforce append-only facts, immutable
// configuration, singleton rows, state transitions, byte ceilings, approval/
// request/attempt identity, outcome/event/reason/mirror consistency, artifact
// lifecycle/completeness combinations, actor checks, serialization, or
// transactional finalization. The eventual PostgreSQL migration/application
// must implement and test these constraints, privileges, locking order, and
// failure semantics. No parser or SQL migration validation is claimed here.
